---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  lang?: string
}

const { title, description = '装甲纷争 - 操控超过200辆历史坦克，体验激烈的装甲战斗', lang = 'zh-CN' } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-g-bg-deep text-g-text-primary font-sans antialiased">
    <!-- Nav -->
    <nav class="sticky top-0 z-50 bg-g-bg-panel/95 backdrop-blur border-b border-g-divider">
      <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="text-g-gold font-bold text-lg tracking-wide">装甲纷争</a>
        <div class="flex items-center gap-6 text-sm text-g-text-secondary">
          <a href="/" class="hover:text-g-parchment transition-colors">首页</a>
          <a href="/policy" class="hover:text-g-parchment transition-colors">隐私政策</a>
          <a
            href="https://www.taptap.cn/app/145106"
            target="_blank"
            rel="noopener"
            class="bg-g-gold text-g-bg-deep font-semibold px-4 py-1.5 rounded-lg hover:brightness-110 transition"
          >
            下载游戏
          </a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-g-divider bg-g-bg-panel mt-16 py-8 text-center text-sm text-g-text-tertiary">
      <div class="max-w-5xl mx-auto px-4 space-y-2">
        <p class="text-g-text-secondary">© 2014–{new Date().getFullYear()} 运营者 王诗江</p>
        <p>
          <a href="https://beian.miit.gov.cn/" target="_blank" class="hover:text-g-parchment transition-colors">
            网站备案信息：沪ICP备15036213号
          </a>
        </p>
        <p class="inline-flex items-center gap-1">
          <img src="/police.png" width="15" height="15" alt="公安备案" />
          <a
            href="https://beian.mps.gov.cn/#/query/webSearch?code=31011302007801"
            rel="noreferrer"
            target="_blank"
            class="hover:text-g-parchment transition-colors"
          >
            沪公网安备31011302007801
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
