---
import Layout from '../layouts/Layout.astro'

const operatorName = '王诗江'
const operatorAddress = '上海市虹口区丹徒路 196 号'
const contactEmail = '403036847@qq.com'
const updateDate = '2026年4月18日'
const effectiveDate = '2026年4月18日'

const sdks = [
  {
    id: 'unity',
    name: 'com.unity3d.player Unity 引擎',
    provider: '优三缔科技（上海）有限公司',
    purpose: '提供游戏运行所依托的引擎能力，支持应用内登录状态留存与基础运行信息统计。',
    data: 'Android ID、已安装应用列表、MAC 地址、设备传感器信息（加速度计、陀螺仪、磁力计等）',
    method: '去标识化和加密处理',
    website: 'https://unity.cn/',
    link: 'https://unity.cn/legal/privacy-policy',
  },
  {
    id: 'topon',
    name: 'com.anythink.china TopOn 广告',
    provider: '广州塔酷信息科技有限公司',
    purpose: '在游戏内进行广告投放与展示，支持应用内广告功能。',
    data: '设备信息（设备序列号、IMEI、MAC 地址、Android ID、IDFV、IDFA、OAID、SSID）、网络信息（IP 地址、路由器标识、网络运营商信息、网络连接状态）、应用信息（应用包名、名称及版本号、签名信息）、软件安装列表',
    method: '去标识化和加密处理',
    website: 'https://www.toponad.com/zh-cn',
    link: 'https://www.toponad.com/zh-cn/privacy-policy',
  },
  {
    id: 'taptap',
    name: 'com.tds.common TapTap 服务',
    provider: '易玩（上海）网络科技有限公司',
    purpose: 'TapTap 账号登录、实名认证与防沉迷服务、跳转游戏社区。同时，TapTap 会获取玩家的联系方式（例如手机号码、电子邮箱），用于用户的注册、登录以及找回密码等账号安全验证操作。',
    data: '玩家联系方式（手机号码、电子邮箱，用于注册、登录及找回密码等账号安全验证）、设备型号、操作系统、设备设置、唯一设备标识符（如 Android ID）、OAID、MAC 地址、登录 IP 地址、TapTap 软件版本号、应用列表、设备所在位置相关信息（WLAN 接入点、网络质量数据和基站传感器信息）、设备环境、操作日志、服务日志信息。',
    method: '按 TapTap 自身隐私政策进行处理',
    website: 'https://www.taptap.com/',
    link: 'https://www.taptap.com/privacy-policy',
  },
  {
    id: 'rxjava',
    name: 'RxJava 响应式编程库',
    provider: 'ReactiveX',
    purpose: '响应式编程运行时，处理异步任务与数据流。',
    data: 'Android ID、应用安装列表',
    method: '去标识化和加密处理',
    website: 'https://github.com/ReactiveX/RxJava',
    link: 'https://github.com/ReactiveX/RxJava',
  },
]

const permissions = [
  { name: '网络访问', purpose: '连接游戏服务器进行在线对战、版本更新、广告与登录服务。', ask: '安装即授予（Android 默认权限）', revocable: '通过系统设置关闭网络' },
  { name: '存储读写', purpose: '下载并保存游戏资源、缓存、存档、日志。', ask: '首次使用前弹窗询问', revocable: '可随时在系统设置中关闭' },
  { name: '设备信息', purpose: '用于设备标识、故障诊断、反作弊与广告 SDK 所需的设备识别。', ask: '首次启动弹窗询问', revocable: '可随时在系统设置中关闭' },
  { name: '传感器（加速度计 / 陀螺仪 / 磁力计）', purpose: '在启用体感瞄准/体感驾驶时作为操控输入。', ask: '首次开启相关功能时询问', revocable: '可在游戏设置中关闭体感功能或在系统设置中关闭' },
]
---

<Layout title="装甲纷争 隐私政策" description="装甲纷争游戏隐私政策">
  <div class="max-w-3xl mx-auto px-4 py-12 text-g-text-secondary leading-relaxed">
    <h1 class="text-3xl font-bold text-g-parchment mb-2">《装甲纷争》隐私政策</h1>
    <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

    <p class="text-sm text-g-text-tertiary">
      更新日期：{updateDate}　·　生效日期：{effectiveDate}
    </p>

    <!-- 温馨提示 -->
    <section class="mt-10">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">温馨提示</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <div class="bg-g-bg-panel border border-g-divider rounded-xl p-6 space-y-3">
        <p>欢迎您使用《装甲纷争》！我们非常重视保护您的个人信息和隐私。您可以通过本隐私政策了解我们收集、使用、存储用户个人信息的情况，以及您所享有的相关权利。请您仔细阅读并充分理解相关内容：</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>为向您提供游戏服务，我们将依据本隐私政策收集、使用、存储必要的信息。</li>
          <li>基于您的明示授权，我们可能会申请开启您的设备权限（如存储、传感器等），您有权拒绝或取消授权。</li>
          <li>您可以访问、更正、删除您的个人信息，还可以撤回授权同意、注销账号、投诉举报以及调整其他隐私设置。</li>
          <li>我们已采取符合业界标准的安全防护措施保护您的个人信息。</li>
          <li>如您是未成年人，请您和您的监护人仔细阅读本隐私政策，并在征得监护人授权同意的前提下使用我们的服务或向我们提供个人信息。</li>
        </ul>
        <p>如您同意本隐私政策，请您点击"同意"开始使用我们的产品和服务，我们将尽全力保护您的个人信息安全。</p>
      </div>

      <!-- 数据境内存储声明 -->
      <div class="mt-4 bg-g-gold-dim border border-g-gold/40 rounded-xl p-5 flex gap-3 items-start">
        <svg class="w-6 h-6 text-g-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <div>
          <p class="text-g-parchment font-semibold mb-1">数据境内存储声明</p>
          <p class="text-sm">本游戏所有用户数据（包括账号信息、游戏进度、日志、设备信息等）<strong class="text-g-parchment">均保存在中国大陆境内服务器</strong>，不会出境传输至中国港澳台地区或境外。</p>
        </div>
      </div>
    </section>

    <!-- 前言 -->
    <section class="mt-10 space-y-4">
      <p>
        {operatorName}（以下简称"我们"）系移动应用程序《装甲纷争》（以下简称"本游戏"或"装甲纷争"）的中国大陆地区运营者。我们非常重视保护用户（以下简称"您"）的个人信息和隐私。您在使用《装甲纷争》时，我们会收集、使用、保存、共享您的相关个人信息。为呈现我们处理您个人信息的情况，我们特制定本《装甲纷争隐私政策》（以下简称"本政策"或"本隐私政策"），我们承诺严格按照本隐私政策处理您的个人信息。
      </p>
      <p>
        在您使用《装甲纷争》前，请您务必认真阅读本隐私政策，充分理解各条款内容，包括但不限于免除或限制我们责任的条款。您知晓并确认，您勾选"同意"本隐私政策并使用《装甲纷争》，就表示您同意我们按照本隐私政策处理您的个人信息。请您知悉，本政策仅适用于我们通过《装甲纷争》向您提供服务所收集的信息，不适用于通过接入《装甲纷争》以向您提供产品或服务的第三方所收集的信息。
      </p>
      <div class="bg-g-bg-panel border border-g-divider rounded-xl p-6">
        <p class="font-semibold text-g-parchment mb-3">本隐私政策将帮助您了解以下内容：</p>
        <ol class="list-decimal pl-6 space-y-1 text-sm">
          <li>我们如何收集和使用您的个人信息</li>
          <li>我们如何保存您的个人信息</li>
          <li>我们如何使用 Cookies 和同类技术</li>
          <li>我们如何共享、转让、公开披露您的个人信息</li>
          <li>第三方产品或服务如何获得您的个人信息</li>
          <li>我们如何保护您的个人信息</li>
          <li>您如何管理您的个人信息</li>
          <li>我们如何处理未成年人的个人信息</li>
          <li>本隐私政策如何更新</li>
          <li>如何联系我们</li>
        </ol>
      </div>
    </section>

    <!-- 1. 收集和使用 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">一、我们如何收集和使用您的个人信息</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（一）我们如何收集您的个人信息</h3>
      <p>在您使用《装甲纷争》过程中，我们会按照如下方式收集您的个人信息：</p>

      <div class="mt-4 space-y-4">
        <div class="bg-g-bg-panel border border-g-divider rounded-xl p-5">
          <h4 class="font-semibold text-g-parchment mb-2">1. 完成登录</h4>
          <p>本游戏目前通过 TapTap 账号完成登录，不独立注册账号。在您使用 TapTap 登录时，我们会接收 TapTap 返回的用户唯一标识、昵称、头像等必要信息，用于在本游戏内创建您的游戏角色、记录您的游戏进度并保障账号安全。如您不提供这类信息，我们将无法为您创建游戏角色并正常向您提供服务。</p>
        </div>

        <div class="bg-g-bg-panel border border-g-divider rounded-xl p-5">
          <h4 class="font-semibold text-g-parchment mb-2">2. 游戏服务</h4>
          <p>当您使用游戏服务时，我们需要收集您使用的设备 ID、设备名称、设备型号、操作系统版本、网络状态、运行日志、战斗数据、游戏内操作行为、传感器数据（如您启用体感操作）。我们收集上述信息是为了保障您正常使用我们的服务，维护游戏基础功能的正常运行，优化游戏产品性能，提升您的游戏体验。如您不提供这类信息，您将无法使用游戏服务。</p>
        </div>

        <div class="bg-g-bg-panel border border-g-divider rounded-xl p-5">
          <h4 class="font-semibold text-g-parchment mb-2">3. 实名认证</h4>
          <p>根据《关于进一步严格管理 切实防止未成年人沉迷网络游戏的通知》等相关法律法规的要求，您需要完成实名认证方可登录游戏。本游戏的实名认证由 TapTap 官方统一提供：您在 TapTap 侧完成实名认证后，TapTap 会返回您的实名状态、年龄段标识等结果信息给本游戏。我们不会在本游戏内单独收集您的姓名、身份证号码等身份证件信息。该认证流程受 TapTap 隐私政策约束。我们收集上述结果信息是为了履行法定义务、识别用户年龄并执行防沉迷规则。如您不完成实名认证，您将无法登录《装甲纷争》或在使用过程中受到相应限制。</p>
        </div>

        <div class="bg-g-bg-panel border border-g-divider rounded-xl p-5">
          <h4 class="font-semibold text-g-parchment mb-2">4. 保障网络和服务的安全</h4>
          <p>为了保障网络和游戏服务的安全性，我们会收集您的设备识别符、IP 地址、访问日期和时间、崩溃日志、异常行为日志。我们收集这些信息用于营造公平、健康及安全的游戏环境，并用于检测外挂、防止作弊、识别异常账号等。如您不提供上述信息，您将无法使用游戏服务。</p>
        </div>

        <div class="bg-g-bg-panel border border-g-divider rounded-xl p-5">
          <h4 class="font-semibold text-g-parchment mb-2">5. 充值消费</h4>
          <p>本游戏当前处于国服测试阶段，暂未开放充值。未来如开放付费内容，充值与支付流程将通过 TapTap 官方渠道完成，相关订单信息（订单号、商品信息、金额、时间）将由我们与 TapTap 依照各自隐私政策进行处理。届时我们会以更新本政策或在充值页面再次提示的方式，告知您具体收集范围并征得您的同意。</p>
        </div>

        <div class="bg-g-bg-panel border border-g-divider rounded-xl p-5">
          <h4 class="font-semibold text-g-parchment mb-2">6. 客服与反馈</h4>
          <p>当您通过邮件或游戏内反馈功能与我们联系时，我们会收集您主动提供的联系方式、问题描述、相关截图或日志，用于处理您的问题并回复您。</p>
        </div>
      </div>

      <!-- 设备权限 -->
      <h3 class="text-lg font-semibold text-g-parchment mt-8 mb-3">（二）设备权限调用情况</h3>
      <p>在您使用《装甲纷争》过程中，我们需要在必要范围内向您申请获取设备权限。请您知悉，我们不会默认开启您设备的权限，仅在您主动确认开启的情况下，本游戏才有可能通过设备权限收集您的信息。《装甲纷争》调用的权限、调用权限的目的以及调用权限前向您询问的情况请见下表：</p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm border border-g-divider rounded-xl overflow-hidden">
          <thead class="bg-g-bg-surface text-g-parchment">
            <tr>
              <th class="text-left px-4 py-3 font-semibold">设备权限</th>
              <th class="text-left px-4 py-3 font-semibold">调用权限的目的</th>
              <th class="text-left px-4 py-3 font-semibold">是否询问</th>
              <th class="text-left px-4 py-3 font-semibold">用户可否关闭</th>
            </tr>
          </thead>
          <tbody class="bg-g-bg-panel">
            {permissions.map((p) => (
              <tr class="border-t border-g-divider align-top">
                <td class="px-4 py-3 text-g-text-primary">{p.name}</td>
                <td class="px-4 py-3">{p.purpose}</td>
                <td class="px-4 py-3">{p.ask}</td>
                <td class="px-4 py-3">{p.revocable}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm">如您在首次授权开启权限后希望关闭权限，您可以在设备的系统设置中选择关闭权限，从而拒绝我们收集相应的个人信息。</p>

      <!-- 如何使用 -->
      <h3 class="text-lg font-semibold text-g-parchment mt-8 mb-3">（三）我们如何使用您的个人信息</h3>
      <ul class="list-disc pl-6 space-y-2">
        <li>我们会根据本政策的约定并为实现我们的服务目的，对所收集的个人信息进行使用。</li>
        <li>您在使用我们提供的服务时所提供的所有个人信息，除非您删除或通过系统设置拒绝我们收集，否则将在您使用我们的服务期间持续授权我们使用。在您注销账号时，我们将停止使用并删除您的个人信息。</li>
        <li>我们会对服务使用情况进行统计，并可能与公众或第三方共享这些统计信息，以用于产品开发、服务优化、安全保障的目的。但这些统计信息不包含您的任何身份识别信息。</li>
        <li>当我们要将您的个人信息用于本政策未载明的其他用途时，或基于特定目的收集而来的信息用于其他目的时，会通过您主动做出勾选的形式事先征求您的同意。</li>
      </ul>

      <!-- 其他规则 -->
      <h3 class="text-lg font-semibold text-g-parchment mt-8 mb-3">（四）其他规则</h3>
      <p>根据相关法律法规及国家标准，以下情形中，我们可能会收集、使用您的相关个人信息而无需征求您的授权同意：</p>
      <ul class="list-disc pl-6 space-y-2 mt-2">
        <li>与我们履行法律法规规定的义务相关的；</li>
        <li>与国家安全、国防安全直接相关的；</li>
        <li>与公共安全、公共卫生、重大公共利益直接相关的；</li>
        <li>与刑事侦查、起诉、审判和判决执行等直接相关的；</li>
        <li>出于维护个人信息主体或其他个人的生命、财产等重大合法权益但又很难得到本人授权同意的；</li>
        <li>所涉及的个人信息是个人信息主体或监护人自行向社会公众公开的；</li>
        <li>根据个人信息主体要求签订和履行合同所必需的；</li>
        <li>从合法公开披露的信息中收集个人信息的，如合法的新闻报道、政府信息公开等渠道；</li>
        <li>维护所提供产品或服务的安全稳定运行所必需的，如发现、处置产品或服务的故障。</li>
      </ul>
    </section>

    <!-- 2. 保存 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">二、我们如何保存您的个人信息</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <p>我们将在本政策载明的目的所需及法律法规要求的最短保存期限之内，保存您的个人信息。前述期限届满后，我们将对您的个人信息做删除或匿名化处理。</p>
      <p class="mt-3"><strong class="text-g-parchment">本游戏所有用户数据均保存在中国大陆境内服务器</strong>（为本政策之目的，"中国大陆境内"不含中国港澳台地区）。我们不会将您的个人信息传输至境外，亦不会向境外的任何组织或个人提供您的个人信息。如因法律明确规定、获得您的明确授权或您主动要求获取境外服务等情形确需进行出境传输的，我们会另行履行告知、取得同意、安全评估等合规程序。</p>
      <p class="mt-3">请您知悉，国服测试期间，所有用户数据同样保存在中国大陆境内服务器；测试结束后，我们将按本政策规定删除或匿名化处理测试阶段产生的玩家游戏数据。</p>
    </section>

    <!-- 3. Cookies -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">三、我们如何使用 Cookies 和同类技术</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <p>《装甲纷争》为一款移动端客户端游戏，本身不在浏览器环境中运行，因此通常不会直接在您的设备上写入浏览器 Cookies。</p>
      <p class="mt-3">但我们和第三方合作伙伴可能会使用 Cookies 或同类技术（如本地存储、设备标识、SDK 日志等）用于以下目的：</p>
      <ul class="list-disc pl-6 space-y-2 mt-2">
        <li><span class="text-g-text-primary font-medium">安全类：</span>帮助我们识别异常登录、防范外挂和作弊行为，保障产品和服务的安全和高效运转。</li>
        <li><span class="text-g-text-primary font-medium">体验类：</span>记录您在游戏内的设置偏好，便于下次启动时自动恢复。</li>
        <li><span class="text-g-text-primary font-medium">推荐类：</span>通过广告 SDK（如 TopOn）向您展示可能感兴趣的广告内容。</li>
      </ul>
      <p class="mt-3">第三方合作伙伴通过 Cookies 或同类技术收集和使用您的信息不受本政策约束，而是受到其自身的隐私政策约束，我们不对第三方的 Cookies 或同类技术承担责任。</p>
      <p class="mt-3">您可以通过设备系统设置（例如重置广告标识符、关闭个性化广告、清除应用数据）来修改或限制相关信息的收集与使用。</p>
    </section>

    <!-- 4. 共享、转让、披露 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">四、我们如何共享、转让、公开披露您的个人信息</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（一）委托处理</h3>
      <p>我们会委托第三方服务提供商处理我们所收集的您的个人信息，以便其为我们提供基础设施技术、数据分析、广告投放、实名认证等产品或技术支持。上述委托处理行为受本政策中所声明目的约束，并且我们会以合同的方式对上述受托的第三方服务提供商进行监督。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（二）共享</h3>
      <p>我们不会与任何公司、组织和个人共享您的个人信息，但以下情况除外：</p>
      <ul class="list-disc pl-6 space-y-2 mt-2">
        <li>事先获得您明确的同意或授权；</li>
        <li>根据适用的法律法规规定，或按照政府主管部门的强制性要求进行提供；</li>
        <li>与我们的业务合作伙伴共享：例如将设备信息、登录标识共享给 TapTap 平台以完成登录与实名认证、共享给广告 SDK 以展示广告，详情见"第三方产品或服务如何获得您的个人信息"。</li>
      </ul>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（三）转让</h3>
      <p>我们不会将您的个人信息转让给任何公司、组织和个人，但在涉及合并、收购、资产转让或破产清算时，如涉及到个人信息转让，我们会向您告知有关情况，并要求新的持有您个人信息的公司、组织继续受本政策的约束，否则我们将要求该公司、组织重新取得您的授权同意。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（四）公开披露</h3>
      <p>除非本政策另有约定或法律明确规定，我们不会公开披露您的个人信息。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（五）例外情况</h3>
      <p>根据相关法律及国家标准，以下情形中，我们可能会共享、转让、公开披露个人信息而无需事先征得您的授权同意：</p>
      <ul class="list-disc pl-6 space-y-2 mt-2">
        <li>与我们履行法律法规规定的义务相关的；</li>
        <li>与国家安全、国防安全直接相关的；</li>
        <li>与公共安全、公共卫生、重大公共利益直接相关的；</li>
        <li>与刑事侦查、起诉、审判和判决执行等直接相关的；</li>
        <li>出于维护个人信息主体或其他个人的生命、财产等重大合法权益但又很难得到本人授权同意的；</li>
        <li>个人信息主体或监护人自行向社会公众公开的个人信息；</li>
        <li>从合法公开披露的信息中收集个人信息的，如合法的新闻报道、政府信息公开等渠道。</li>
      </ul>
      <p class="mt-3">请注意，您在使用我们服务时自愿共享甚至公开分享的信息（如游戏内昵称、聊天、战绩分享），可能会涉及您或他人的个人信息甚至个人敏感信息。请您谨慎共享或公开。</p>
    </section>

    <!-- 5. 第三方 SDK -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">五、第三方产品或服务如何获得您的个人信息</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <p>为了向您提供更丰富和完整的功能，我们会使用下述第三方软件开发工具包（简称"SDK"）为您提供服务。SDK 的具体信息收集和使用情况请以 SDK 运营方的隐私政策或相关声明为准。</p>

      <div class="mt-6 space-y-4">
        {sdks.map((sdk, idx) => (
          <details class="group bg-g-bg-panel border border-g-divider rounded-xl overflow-hidden" open={idx === 0}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer hover:bg-g-bg-surface transition-colors">
              <h3 class="font-semibold text-g-parchment">{sdk.name}</h3>
              <svg class="w-5 h-5 text-g-text-tertiary group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 border-t border-g-divider pt-4">
              <dl class="space-y-2 text-sm">
                <div><dt class="inline font-medium text-g-text-primary">第三方主体：</dt><dd class="inline">{sdk.provider}</dd></div>
                <div><dt class="inline font-medium text-g-text-primary">使用目的：</dt><dd class="inline">{sdk.purpose}</dd></div>
                <div><dt class="inline font-medium text-g-text-primary">收集的信息：</dt><dd class="inline">{sdk.data}</dd></div>
                <div><dt class="inline font-medium text-g-text-primary">处理方式：</dt><dd class="inline">{sdk.method}</dd></div>
                <div><dt class="inline font-medium text-g-text-primary">官网链接：</dt><dd class="inline"><a href={sdk.website} target="_blank" rel="noopener" class="text-g-gold hover:underline">{sdk.website}</a></dd></div>
                <div><dt class="inline font-medium text-g-text-primary">隐私政策：</dt><dd class="inline"><a href={sdk.link} target="_blank" rel="noopener" class="text-g-gold hover:underline">{sdk.link}</a></dd></div>
              </dl>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- 6. 保护 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">六、我们如何保护您的个人信息</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <ul class="list-disc pl-6 space-y-2">
        <li>我们采取了行业通行的数据保护技术与管理措施，例如网络隔离、传输加密（TLS）、存储加密、员工访问控制、安全审计等，以防止个人信息遭到未经授权的访问、披露、篡改、丢失或毁坏。</li>
        <li>请您知悉，虽然我们将尽力确保您发送给我们的任何信息的安全性，但互联网环境并非百分之百安全，我们亦不对由此产生或与之相关的任何风险、损失承担超出法律规定以外的责任。</li>
        <li>在不幸发生个人信息安全事件后，我们将按照法律法规的要求，及时向您告知：安全事件的基本情况和可能的影响、我们已采取或将要采取的处置措施、您可自主防范和降低风险的建议、对您的补救措施等。我们将通过应用内通知、邮件、短信、电话等方式告知您；难以逐一告知个人信息主体时，我们会采取合理、有效的方式发布公告。同时，我们还将按照监管部门要求，主动上报个人信息安全事件的处置情况。</li>
      </ul>
    </section>

    <!-- 7. 您如何管理 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">七、您如何管理您的个人信息</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <p>在您使用《装甲纷争》期间，您可以通过相应页面提示或本隐私政策载明的方式联系我们，以访问、更正、删除您的个人信息，以及行使改变授权同意的范围与注销账号的权利，您的意见会及时得到处理。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（一）访问及更正您的个人信息</h3>
      <p>您可以在游戏内"设置 - 账号"或"设置 - 个人资料"中查看、更新您的昵称、头像、联系方式等资料。如您希望访问或更正其他个人信息，可以通过本隐私政策载明的方式与我们联系，我们将及时响应您的请求。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（二）删除您的个人信息</h3>
      <p>在以下情形中，您可以通过本隐私政策载明的方式向我们提出删除个人信息的请求：</p>
      <ul class="list-disc pl-6 space-y-2 mt-2">
        <li>我们违反法律、行政法规或与您的约定收集、使用个人信息；</li>
        <li>我们违反法律、行政法规或与您的约定与第三方共享或转让您的个人信息，我们将立即停止共享、转让行为，并通知第三方及时删除；</li>
        <li>我们违反法律、行政法规或与您的约定，公开披露您的个人信息，我们将立即停止公开披露的行为，并发布通知要求相关接收方删除相应的信息；</li>
        <li>您不再使用我们的产品或服务，或您注销了账号，或我们终止服务及运营。</li>
      </ul>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（三）改变您授权同意的范围</h3>
      <p>您可以通过设备权限设置或本隐私政策载明的方式与我们联系，以改变同意范围或撤回您的授权。请您理解，《装甲纷争》可能需要开启部分权限并收集必要的个人信息才能得以实现。当您撤回您的同意时，我们将无法继续为您提供撤回同意所对应的服务，但不会影响此前基于您的授权而开展的个人信息处理。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（四）注销账户</h3>
      <p>如果您希望注销您的账户，您可以在游戏内"设置 - 账号 - 注销账号"根据页面提示进行相应操作，或通过本隐私政策载明的方式与我们联系，我们将在核验您的身份后及时响应您的请求。您注销账户的行为是不可逆的，我们将停止为您提供产品或服务，不再收集您的个人信息，并依据您的要求删除与您账户相关的个人信息或做匿名化处理。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（五）响应您的上述请求</h3>
      <p>如您无法按照上述方式行使权利，您可以采取本隐私政策载明的联系方式与我们联系。为保障安全，您可能需要提供书面请求，或以其他方式证明您的身份。我们可能会先要求您验证自己的身份，然后再处理您的请求。对于您合理的请求，我们原则上不收取费用，但对多次重复、超出合理限度的请求，我们将视情收取一定成本费用。对于那些无端重复、需要过多技术手段、给他人合法权益带来风险或者非常不切实际的请求，我们可能会予以拒绝。</p>

      <h3 class="text-lg font-semibold text-g-parchment mt-6 mb-3">（六）响应情形的例外</h3>
      <p>在以下情形中，我们将无法响应您的请求：</p>
      <ul class="list-disc pl-6 space-y-2 mt-2">
        <li>与我们履行法律法规规定的义务相关的；</li>
        <li>与国家安全、国防安全直接相关的；</li>
        <li>与公共安全、公共卫生、重大公共利益直接相关的；</li>
        <li>与刑事侦查、起诉、审判和执行判决等直接相关的；</li>
        <li>我们有充分证据表明个人信息主体存在主观恶意或滥用权利的；</li>
        <li>出于维护个人信息主体或其他个人的生命、财产等重大合法权益但又很难得到本人同意的；</li>
        <li>响应个人信息主体的请求将导致个人信息主体或其他个人、组织的合法权益受到严重损害的；</li>
        <li>涉及商业秘密的。</li>
      </ul>
    </section>

    <!-- 8. 未成年人 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">八、我们如何处理未成年人的个人信息</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <p>本游戏适龄提示为 16 岁以上用户。我们非常重视对未成年人个人信息的保护。根据相关法律法规的规定，收集、使用未满 14 周岁的未成年人的个人信息，需由监护人授权同意；收集、使用已满 14 周岁未满 18 周岁的未成年人个人信息，可由监护人授权同意或自行授权同意。</p>
      <p class="mt-3">如您为未成年人（尤其是不满 14 周岁的未成年人），我们要求您请您的父母或其他监护人仔细阅读本隐私政策，并在征得您的监护人授权同意的前提下使用我们的服务或向我们提供信息。</p>
      <p class="mt-3">如您是未成年人的监护人，请您关注您所监护的未成年人是否是在您授权同意之后使用我们的产品或服务。如果您对您所监护的未成年人的个人信息有疑问，请通过本隐私政策载明的方式与我们联系。</p>
      <p class="mt-3">本游戏严格执行国家新闻出版署关于未成年人防沉迷的相关要求，通过 TapTap 实名认证系统识别未成年人账号，并对其游戏时长、游戏时段与消费金额进行限制。</p>
    </section>

    <!-- 9. 更新 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">九、本隐私政策如何更新</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <p>我们的隐私政策可能会适时发生变更。我们会在本页面上发布对本隐私政策所做的任何变更。对于重大变更，我们还会提供更为显著的通知（例如通过游戏启动页、应用内弹窗等方式，说明隐私政策的具体变更内容）。未经您明确同意，我们不会削减您按照本隐私政策所应享有的权利。</p>
      <p class="mt-3">本隐私政策所指的重大变更包括但不限于：我们的服务模式发生重大变化；个人信息共享、转让或公开披露的主要对象发生变化；您参与个人信息处理方面的权利及其行使方式发生重大变化；我们的联系方式及投诉渠道发生变化；个人信息安全影响评估报告表明存在高风险时。</p>
      <p class="mt-3">我们还会将本隐私政策的旧版本存档，供您查阅。</p>
    </section>

    <!-- 10. 联系 -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-g-parchment mb-2">十、如何联系我们</h2>
      <div class="w-12 h-1 bg-g-gold rounded mb-6"></div>

      <p>如果您对本政策或个人信息保护有任何问题，您可以将您的书面疑问、意见或建议通过以下方式联系我们：</p>
      <div class="mt-4 bg-g-bg-panel border border-g-divider rounded-xl p-6 space-y-2 text-sm">
        <p><span class="text-g-text-primary font-medium">运营者名称：</span>{operatorName}</p>
        <p><span class="text-g-text-primary font-medium">通讯地址：</span>{operatorAddress}</p>
        <p><span class="text-g-text-primary font-medium">联系邮箱：</span><a href={`mailto:${contactEmail}`} class="text-g-gold hover:underline">{contactEmail}</a></p>
      </div>
      <p class="mt-4">一般情况下，我们将在十五个工作日内回复。如果您对我们的回复不满意，特别是我们的个人信息处理行为损害了您的合法权益，您还可以向网信、电信、公安及工商等监管部门进行投诉或举报，或通过向被告住所地有管辖权的人民法院提起诉讼来寻求解决方案。</p>
    </section>

    <p class="mt-12 text-sm text-g-text-tertiary border-t border-g-divider pt-6">
      最后修改日期：{updateDate}　·　生效日期：{effectiveDate}
    </p>
  </div>
</Layout>
